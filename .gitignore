# Node
node_modules/
npm-debug.log*

# Python
__pycache__/
*.pyc
.venv/
venv/

# Environment / secrets
.env
.env.*
*.key

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Logs
*.log

# Ad-hoc data backups (e.g. data/jobs.json.backup-YYYYMMDD-HHMMSS) made before
# a live discovery run -- safety copies, never intentionally committed.
data/*.backup*

# Personal documents (resumes, cover letters may contain PII)
profile/resume/*
!profile/resume/.gitkeep
applications/resumes/*
!applications/resumes/.gitkeep
applications/cover_letters/*
!applications/cover_letters/.gitkeep
applications/answers/*
!applications/answers/.gitkeep
applications/pending/*
!applications/pending/.gitkeep
applications/review/*
!applications/review/.gitkeep

# Phase 6 job-analysis cache (may reference candidate evidence/PII)
data/application_intelligence/
